<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Epigraph">
<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
<Content>I will be their God, and they shall be </Content>
